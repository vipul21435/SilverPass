# ---------------------------------------------------------------------------
# SilverPass configuration
# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# HTTP port for the API server.
PORT=4000

# node environment: development | test | production
NODE_ENV=development

# Secret used to sign JSON Web Tokens.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an access token stays valid (zeit/ms format: 15m, 2h, 7d).
JWT_EXPIRES_IN=2h

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Storage backend: "json" (default, zero setup) or "mongo".
STORE=json

# Where the JSON store keeps its data. Relative paths resolve from server/.
JSON_STORE_PATH=data/silverpass.json

# Only read when STORE=mongo.
MONGO_URI=
MONGO_DB_NAME=silverpass

# Set to 1 to ignore .env files entirely and take configuration only from the
# environment. Useful in containers where no stray file should contribute.
SILVERPASS_SKIP_DOTENV=
