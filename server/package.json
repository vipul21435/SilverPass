{
  "name": "@silverpass/server",
  "version": "1.0.0",
  "private": true,
  "description": "SilverPass REST API.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --import ./test/setup.js --test-concurrency=1 \"test/**/*.test.js\"",
    "test:watch": "node --test --import ./test/setup.js --watch \"test/**/*.test.js\"",
    "test:mongo": "node scripts/test-mongo.js",
    "test:all": "npm run test && npm run test:mongo",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0"
  }
}
